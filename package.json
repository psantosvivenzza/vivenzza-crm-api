    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.0",
    "google-ads-api": "^24.1.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.4.1",
    "node-forge": "^1.4.0",
    "pg": "^8.21.0",
    "xml-crypto": "^6.1.2",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.3"
