    "sync:clientes:legado:dry-run": "node scripts/sync-clientes-legado.mjs --dry-run",
    "sync:clientes:legado": "node scripts/sync-clientes-legado.mjs",
    "analise:duplicados-financeiro": "node scripts/analise-duplicados-financeiro.mjs",
    "preview:duplicados-financeiro": "node scripts/preview-duplicados-financeiro.mjs",
