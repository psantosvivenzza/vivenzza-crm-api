{
  "name": "vivenzza-crm-api",
  "version": "1.0.0",
  "description": "Backend API para o CRM Vivenzza",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:local:start": "node scripts/localdb-start.mjs",
    "db:local:stop": "node scripts/localdb-stop.mjs",
    "db:local:reset": "node scripts/localdb-reset.mjs",
    "test:collection": "node scripts/run-collection-tests.mjs",
    "test:meta-budget-guard": "node scripts/teste-meta-budget-guard.mjs",
    "ai:worker": "node scripts/ai-worker.mjs",
    "voice:service": "node scripts/voice/run-voice-service.mjs",
    "voice:outbound:test": "node scripts/voice/trigger-outbound-test.mjs",
    "audit:netvision:pedidos": "node scripts/audit-netvision-pedidos.mjs",
    "audit:netvision:faturamento": "node scripts/audit-netvision-faturamento.mjs",
    "audit:netvision:financeiro": "node scripts/audit-netvision-financeiro.mjs",
    "audit:netvision:clientes": "node scripts/audit-netvision-clientes.mjs",
    "audit:netvision:pagamentos": "node scripts/audit-netvision-pagamentos.mjs",
