.env
.env.*.local
.env.backup-*
node_modules/

# Ambiente de desenvolvimento local (Postgres) — ver
# docs/cobranca-ai/LOCAL_DEVELOPMENT.md. Nunca commitar dados/binários locais.
.localdev/
supabase/.temp/

# Amostras de áudio de benchmark de voz (só pra ouvir localmente, nunca commitar binário)
scripts/voice/benchmark-output/

# Servidor de voz portátil — arquivo real de config (segredos: senha ARI/SIP,
# credenciais Bluetooth), nunca commitado. Só voice-server.env.example é
# versionado. Backups do Asterisk (scripts/voice-server/backup-asterisk.sh)
# são gravados FORA do repo de propósito — nunca aparecem aqui por acidente.
voice-server.env

# Backups do .env guardam o arquivo INTEIRO, com senha do ARI, chave do
# Supabase e tokens. Nao estavam ignorados ate 18/09/2026 — um `git add .`
# distraido mandaria credencial de producao para o GitHub.
.env.bak*
*.bak-*
*.bak1
logs/
