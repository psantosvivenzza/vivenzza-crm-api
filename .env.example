# Supabase
SUPABASE_URL=https://vkncsyhugotyfwmxpzgq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Servidor
PORT=3001
NODE_ENV=development

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Segurança
API_SECRET_KEY=

# Token de alerta para rotinas automatizadas (POST /api/public/alerta-whatsapp)
# Escopo estreito: só manda WhatsApp de alerta pro número fixo no route handler,
# não dá acesso a mais nada da API — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALERT_WEBHOOK_TOKEN=

# JWT
JWT_SECRET=

# Meta Ads
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0

# Google Ads
# 1. Crie um projeto no Google Cloud Console → APIs → Google Ads API
# 2. Crie credenciais OAuth2 (tipo "Desktop app") → CLIENT_ID + CLIENT_SECRET
# 3. Obtenha o Developer Token em ads.google.com → Ferramentas → API Center
# 4. Para o REFRESH_TOKEN, rode: node scripts/get-refresh-token.js
# 5. CUSTOMER_ID: conta de anúncios (sem hífens, ex: 1234567890)
# 6. LOGIN_CUSTOMER_ID: conta MCC (só necessário se acessar via MCC)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# NF-e — senha do certificado .pfx (ver src/services/nfe/emitente.js). Nunca commitar
# o valor real; setar direto no Railway (Variables) como secret.
NFE_CERT_SENHA=

# Nuvemshop — app "Vivenzza Content Publisher" (App ID 36940) no Portal de Parceiros
# Client ID/secret do app. O access_token e store_id da loja NÃO ficam em env
# var — são salvos automaticamente na tabela Supabase "nuvemshop_credentials"
# pelo callback GET /api/nuvemshop/oauth/callback após o "Aceitar" na loja.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=

# Google Places API (Place Details - Legacy) — nota geral + 5 reviews mais
# recentes do Google Business Profile da Vivenzza. Cache diário em
# google_reviews_cache, não precisa de aprovação especial do Google.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# WordPress — autenticação via Application Password (Usuário → Perfil →
# Senhas de Aplicativo), NÃO a senha normal da conta.
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# Guard de frescor do sync financeiro (src/lib/collection/financialSyncGuard.js)
# — protege TODO envio real de cobrança WhatsApp (cron, /disparar,
# /disparar-individual) contra rodar com dados desatualizados do NetVision.
# Ausente/vazio = true (default seguro, nunca "ausente == desligado" num
# guard de segurança). Só "false" literal desliga.
COBRANCA_EXIGE_SYNC=true
# Idade máxima aceitável (minutos) do último sync financeiro concluído com
# sucesso. Ausente/inválido/<=0 = usa 240 (4h) como default seguro.
COBRANCA_SYNC_MAX_ATRASO_MIN=240

# Idade máxima aceitável (minutos) do último sync fiscal (EN_Notas →
# notas_fiscais_netvision) pro indicador "VENDAS DO MÊS" do dashboard
# (src/lib/vendaFiscalSyncStatus.js). Ausente/inválido/<=0 = usa 1440 (24h).
VENDAS_FISCAIS_SYNC_MAX_ATRASO_MIN=1440

# ============================================================================
# Voice AI — Asterisk/ARI/PJSIP (src/lib/voice/) — ver docs/cobranca-ai/VOICE.md
# e config/asterisk/README.md. Homologado hoje SÓ pro ramal interno de teste
# (PJSIP/7001, ver src/lib/voice/outboundInternalTest.js) — nenhuma destas
# variáveis, sozinha ou em conjunto, autoriza uma chamada PSTN externa.
# ============================================================================
ARI_URL=http://127.0.0.1:8088
ARI_USER=
ARI_PASSWORD=
ARI_APP=vivenzza-voice-ai
ASTERISK_SOUNDS_DIR=
ASTERISK_RECORDINGS_DIR=
VOICE_MAX_TURNOS=2
VOICE_RECORD_MAX_DURATION_S=8
VOICE_RECORD_MAX_SILENCE_S=1

# STT (faster-whisper) / TTS (Piper, voz "Jeff" = pt_BR-jeff-medium) — sidecars
# Python locais, nunca acoplados ao runtime Node (src/lib/voice/pyWorkerClient.js).
VOICE_PYTHON_BIN=python
VOICE_STT_MODEL=small
VOICE_STT_WORKER_SCRIPT_PATH=scripts/voice/stt_worker.py
VOICE_STT_SCRIPT_PATH=
VOICE_TTS_MODEL_PATH=
VOICE_TTS_WORKER_SCRIPT_PATH=scripts/voice/tts_worker.py
VOICE_TTS_SCRIPT_PATH=
VOICE_TTS_LENGTH_SCALE=1.00
VOICE_TTS_PREROLL_MS=200
VOICE_LLM_NUM_PREDICT_MAX=150

# LLM (mesmo motor do WhatsApp — Ollama local, sem provedor de voz separado).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# Voice AI — prontidão SIP trunk EXTERNO (Nvoip). Nada aqui é lido/usado por
# nenhum adapter de trunk ainda — src/lib/voice/destinoResolver.js mantém
# TRUNK_EXTERNO_CONFIGURADO=false hardcoded no código (não numa env var) até
# um trunk real ser homologado. Preencher estes valores NUNCA, sozinho,
# libera uma chamada PSTN — o kill switch é automacoes_config.
# voice_external_enabled (banco, default false, só SQL direto por um
# operador — sem PATCH route de propósito).
# ----------------------------------------------------------------------------
NVOIP_SIP_SERVER=
NVOIP_SIP_PORT=
NVOIP_SIP_USERNAME=
NVOIP_SIP_PASSWORD=
NVOIP_SIP_OUTBOUND_PROXY=
NVOIP_CALLER_ID=

# Allowlist da primeira homologação pública — formato E.164/BR, separado por
# vírgula (mesmo padrão de COLLECTION_TEST_PHONE_ALLOWLIST). Vazio por
# padrão: nenhum número é permitido até isto ser preenchido explicitamente,
# e mesmo preenchido, ainda precisa de voice_external_enabled=true (banco) E
# de um trunk/adapter real (nenhum existe ainda).
VOICE_EXTERNAL_ALLOWLIST=

# Limites conservadores/fail-closed (src/lib/voice/externalConfig.js) —
# defaults pequenos de propósito, primeira homologação é 1 número.
VOICE_MAX_CALLS_HOUR=1
VOICE_MAX_CALLS_DAY=3
VOICE_MAX_CALLS_PER_PHONE_DAY=1
