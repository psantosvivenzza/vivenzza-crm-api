# Configuração do SERVIDOR DE VOZ (Asterisk + workers STT/TTS) — máquina
# própria, separada de onde o backend CRM roda (Railway). Ver
# scripts/voice-server/README.md para o procedimento de instalação completo.
#
# Este arquivo é só PLACEHOLDER (nenhum valor real, nenhum segredo). O
# arquivo real (`voice-server.env`, sem ".example") é criado À MÃO em cada
# máquina (laboratório ou servidor definitivo da empresa) e nunca é
# commitado — ver .gitignore. NENHUM script deste kit lê/escreve segredo em
# nenhum arquivo rastreado pelo Git.
#
# NUNCA preencher aqui: nome de máquina, usuário do SO, caminho local
# específico, IP da rede local, MAC Bluetooth, número de celular. Tudo isso
# é decidido na hora da instalação, na máquina de destino — nunca hardcoded
# no repositório (ver scripts/voice-server/README.md, seção "Portabilidade").

# ============================================================================
# Modo do servidor — só documental/informativo pros scripts de validação,
# nunca muda comportamento do Asterisk sozinho.
# ============================================================================
# lab = ambiente de desenvolvimento/teste (qualquer máquina)
# producao = servidor definitivo da empresa, permanentemente ligado
VOICE_SERVER_MODE=lab

# ============================================================================
# Asterisk — ARI (Asterisk REST Interface), sempre loopback (127.0.0.1),
# nunca exposto na rede. Ver config/asterisk/ari.conf.example/http.conf.example.
# ============================================================================
ASTERISK_HOST=127.0.0.1
ASTERISK_ARI_PORT=8088
ARI_URL=http://127.0.0.1:8088
ARI_USER=
ARI_PASSWORD=
ARI_APP=vivenzza-voice-ai

# ============================================================================
# Ramal interno homologado (7001 → 8001 → Stasis) — mesmo em qualquer
# máquina, definido em config/asterisk/pjsip.conf.example/extensions.conf.example.
# Normalmente não precisa mudar; existe aqui só para permitir override.
# ============================================================================
VOICE_INTERNAL_EXTENSION=7001
VOICE_INTERNAL_DIALIN=8001

# ============================================================================
# STT/TTS — workers Python persistentes (ver scripts/voice/README.md).
# Caminhos absolutos: PREENCHER na máquina de destino, nunca aqui.
# ============================================================================
VOICE_PYTHON_BIN=python3
VOICE_STT_MODEL=small
VOICE_TTS_MODEL_PATH=
VOICE_STT_SCRIPT_PATH=
VOICE_TTS_SCRIPT_PATH=
VOICE_STT_WORKER_SCRIPT_PATH=
VOICE_TTS_WORKER_SCRIPT_PATH=
VOICE_WORKER_READY_TIMEOUT_MS=60000
VOICE_TTS_LENGTH_SCALE=1.00
VOICE_TTS_PREROLL_MS=200

# Diretório de diagnóstico da última ligação — deixar vazio usa o default
# (pasta temp do usuário do SO local, resolvida em runtime, nunca hardcoded
# aqui).
VOICE_LAST_CALL_DIAG_DIR=

# ============================================================================
# Bluetooth / celular — camada PLUGÁVEL (ver
# scripts/voice-server/preparar-bluetooth-celular.md). Vazio até um
# aparelho real ser pareado no servidor definitivo — nenhum destes campos
# deve conter o celular/MAC atual do laboratório.
# ============================================================================
VOICE_MOBILE_ADAPTER=
VOICE_MOBILE_DEVICE=
VOICE_MOBILE_PIN=

# ============================================================================
# Chamada externa (PSTN) — flags de segurança. Ficam FALSE até uma
# autorização explícita e específica, mesmo depois de tudo instalado no
# servidor definitivo. A simples presença do Asterisk/gateway não pode, por
# si só, permitir ligação externa.
# ============================================================================
VOICE_EXTERNAL_ENABLED=false
TRUNK_EXTERNO_CONFIGURADO=false
VOICE_EXTERNAL_ALLOWLIST=
VOICE_MAX_CALLS_HOUR=1
VOICE_MAX_CALLS_DAY=3
VOICE_MAX_CALLS_PER_PHONE_DAY=1

# ============================================================================
# Integração CRM ↔ servidor de voz — mecanismo de comunicação ainda não
# implementado (ver scripts/voice-server/README.md, seção "Integração
# CRM/Asterisk"). Placeholder para quando existir.
# ============================================================================
VOICE_SERVER_TUNNEL_MODE=
VOICE_SERVER_TUNNEL_ENDPOINT=
