<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Dispara a fila de ligacao de cobranca por voz as 16h, 17h e 18h - faixa com 83% de atendimento contra 25% de manha.</Description>
    <URI>\VivenzzaFilaCobrancaVoz</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>[REDACTED-LOCAL-SID]</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT50M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-09-18T16:00:00-03:00</StartBoundary>
      <Repetition>
        <Interval>PT1H</Interval>
        <Duration>PT2H</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\msi\Projeto Claude Code\vivenzza-crm-api\fila-cobranca-voz.bat</Command>
      <WorkingDirectory>C:\Users\msi\Projeto Claude Code\vivenzza-crm-api</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
