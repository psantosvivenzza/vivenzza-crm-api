  "constraints": [
    {
      "table_name": "collection_dispatches",
      "conname": "collection_dispatches_canal_check",
      "definition": "CHECK ((canal = ANY (ARRAY['whatsapp'::text, 'ai_whatsapp'::text])))"
    },
    {
      "table_name": "collection_dispatches",
      "conname": "collection_dispatches_contas_financeiras_id_fkey",
      "definition": "FOREIGN KEY (contas_financeiras_id) REFERENCES contas_financeiras(id)"
    },
    {
      "table_name": "collection_dispatches",
      "conname": "collection_dispatches_origem_check",
      "definition": "CHECK ((origem = ANY (ARRAY['cron'::text, 'manual'::text, 'nba'::text])))"
    },
    {
      "table_name": "collection_dispatches",
      "conname": "collection_dispatches_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "collection_dispatches",
      "conname": "collection_dispatches_purpose_check",
      "definition": "CHECK ((purpose = ANY (ARRAY['collection'::text, 'internal_test'::text])))"
    },
    {
      "table_name": "collection_dispatches",
      "conname": "collection_dispatches_purpose_conta_check",
      "definition": "CHECK (((purpose = 'internal_test'::text) OR (contas_financeiras_id IS NOT NULL)))"
    },
    {
      "table_name": "collection_dispatches",
      "conname": "collection_dispatches_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['queued'::text, 'sending'::text, 'sent'::text, 'delivered'::text, 'read'::text, 'failed'::text, 'expired'::text, 'cancelled'::text])))"
    },
    {
      "table_name": "collection_promises",
      "conname": "collection_promises_contas_financeiras_id_fkey",
      "definition": "FOREIGN KEY (contas_financeiras_id) REFERENCES contas_financeiras(id)"
    },
    {
      "table_name": "collection_promises",
      "conname": "collection_promises_origem_check",
      "definition": "CHECK ((origem = ANY (ARRAY['AUTOMATION'::text, 'AI'::text, 'HUMAN'::text])))"
    },
    {
      "table_name": "collection_promises",
      "conname": "collection_promises_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "collection_promises",
      "conname": "collection_promises_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['ativa'::text, 'cumprida'::text, 'quebrada'::text, 'cancelada'::text])))"
    },
    {
      "table_name": "collection_timeline_events",
      "conname": "collection_timeline_events_contas_financeiras_id_fkey",
      "definition": "FOREIGN KEY (contas_financeiras_id) REFERENCES contas_financeiras(id)"
    },
    {
      "table_name": "collection_timeline_events",
      "conname": "collection_timeline_events_criado_por_fkey",
      "definition": "FOREIGN KEY (criado_por) REFERENCES usuarios(id)"
    },
    {
      "table_name": "collection_timeline_events",
      "conname": "collection_timeline_events_origem_check",
      "definition": "CHECK ((origem = ANY (ARRAY['AUTOMATION'::text, 'AI'::text, 'HUMAN'::text, 'SYSTEM'::text, 'PAYMENT_RECONCILIATION'::text])))"
    },
    {
      "table_name": "collection_timeline_events",
      "conname": "collection_timeline_events_pkey",
      "definition": "PRIMARY KEY (id)"
    }
